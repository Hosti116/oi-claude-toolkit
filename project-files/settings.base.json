{
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(./secrets/**)",
      "Read(./**/*.pfx)",
      "Read(./**/*.p12)",
      "Read(./**/*.key)",
      "Read(./**/.env)",
      "Read(./.sg-state/**)"
    ],
    "ask": [
      "Bash(sqlcmd:*)",
      "Bash(git push:*)",
      "Bash(Invoke-Safeguard*)",
      "Bash(pwsh:*)",
      "Bash(powershell:*)"
    ]
  }
}
